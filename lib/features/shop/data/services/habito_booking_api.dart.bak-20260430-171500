  static Future<void> _loadCache() async {
    try {
      final file = await _cacheFile();
      if (!await file.exists()) return;

      final raw = await file.readAsString();
      if (raw.trim().isEmpty) return;

      final decoded = jsonDecode(raw);
      if (decoded is! Map<String, dynamic>) return;

      _restoreListCache(
        decoded['services'],
        onData: (items, cachedAt) {
          _cachedServices = items;
          _servicesCachedAt = cachedAt;
        },
      );
      _restoreListCache(
        decoded['employees'],
        onData: (items, cachedAt) {
          _cachedEmployees = items;
          _employeesCachedAt = cachedAt;
        },
      );
      _restoreListCache(
        decoded['locations'],
        onData: (items, cachedAt) {
          _cachedLocations = items;
          _locationsCachedAt = cachedAt;
        },
      );
    } catch (_) {
      // Cache best effort.
    }
  }

  static void _restoreListCache(
    dynamic value, {
    required void Function(List<dynamic> items, DateTime cachedAt) onData,
  }) {
    if (value is! Map) return;

    final map = Map<String, dynamic>.from(value);
    final cachedAt = DateTime.tryParse(map['cached_at']?.toString() ?? '');
    final items = map['data'] is List ? List<dynamic>.from(map['data']) : null;

    if (cachedAt == null || items == null || !_isCacheUsable(cachedAt)) return;

    onData(items, cachedAt);
  }

  static Future<void> _persistCache() async {
    try {
      final file = await _cacheFile();
      await file.writeAsString(
        jsonEncode({
          if (_cachedServices != null && _servicesCachedAt != null)
            'services': {
              'cached_at': _servicesCachedAt!.toIso8601String(),
              'data': _cachedServices,
            },
          if (_cachedEmployees != null && _employeesCachedAt != null)
            'employees': {
              'cached_at': _employeesCachedAt!.toIso8601String(),
              'data': _cachedEmployees,
            },
          if (_cachedLocations != null && _locationsCachedAt != null)
            'locations': {
              'cached_at': _locationsCachedAt!.toIso8601String(),
              'data': _cachedLocations,
            },
        }),
      );
    } catch (_) {
      // Cache best effort.
    }
  }

  static Future<File> _cacheFile() async {
    final dir = await getApplicationDocumentsDirectory();
    final cacheDir =
        Directory('${dir.path}${Platform.pathSeparator}booking_cache');
    if (!await cacheDir.exists()) {
      await cacheDir.create(recursive: true);
    }
    return File('${cacheDir.path}${Platform.pathSeparator}catalog.json');
  }

  static Future<void> _deleteCacheFile() async {
    try {
      final file = await _cacheFile();
      if (await file.exists()) {
        await file.delete();
      }
    } catch (_) {
      // Cache best effort.
    }
  }

  static Map<String, dynamic> _decodeResponse(http.Response response) {
    try {
      final decoded = jsonDecode(response.body);

      if (decoded is Map<String, dynamic>) {
        if (response.statusCode == 401) {
          throw Exception(
            decoded['message']?.toString() ??
                decoded['error']?['message']?.toString() ??
                'Sesión expirada. Por favor inicia sesión nuevamente.',
          );
        }

        if (response.statusCode == 403) {
          throw Exception(
            decoded['message']?.toString() ??
                decoded['error']?['message']?.toString() ??
                'No tienes permisos para realizar esta acción.',
          );
        }

        if (response.statusCode >= 500) {
          throw Exception(
            decoded['message']?.toString() ??
                decoded['error']?['message']?.toString() ??
                decoded['error']?['data']?['response']?['message']
                    ?.toString() ??
                'Error en el servidor. Intenta más tarde.',
          );
        }

        return decoded;
      }

      throw Exception('Respuesta inesperada del servidor');
    } catch (e) {
      if (response.statusCode == 401) {
        throw Exception('Sesión expirada. Por favor inicia sesión nuevamente.');
      }
      if (response.statusCode == 403) {
        throw Exception('No tienes permisos para realizar esta acción.');
      }
      if (response.statusCode >= 500) {
        throw Exception(
          'Error 500 del servidor. Respuesta: ${response.body}',
        );
      }

      if (e is Exception) rethrow;
      throw Exception('Error decodificando respuesta (${response.statusCode})');
    }
  }

  static Map<String, dynamic> _extractBookingPayload(
    Map<String, dynamic> data,
  ) {
    final rootData = data['data'];

    if (rootData is Map<String, dynamic>) {
      final nestedData = rootData['data'];

      if (nestedData is Map<String, dynamic>) {
        return Map<String, dynamic>.from(nestedData);
      }

      return Map<String, dynamic>.from(rootData);
    }

    if (data['appointment_id'] != null ||
        data['booking_id'] != null ||
        data['appointmentId'] != null ||
        data['bookingId'] != null) {
      return Map<String, dynamic>.from(data);
    }

    throw Exception('Respuesta inesperada al crear la reserva');
  }

  static String _extractErrorMessage(Map<String, dynamic> data) {
    final detailedResponse = data['error']?['data']?['response'];

    final detailedMessage = detailedResponse is Map<String, dynamic>
        ? (detailedResponse['message'] ??
            detailedResponse['error']?['message'] ??
            detailedResponse.toString())
        : detailedResponse?.toString();

    final baseMessage = detailedMessage ??
        data['message']?.toString() ??
        data['error']?['message']?.toString() ??
        'Ocurrió un error inesperado';

    final missingFields = data['missing'];
    if (missingFields is List && missingFields.isNotEmpty) {
      final labels = missingFields
          .map((field) => _humanizeBookingField(field?.toString()))
          .where((field) => field.isNotEmpty)
          .join(', ');

      if (labels.isNotEmpty) {
        return '$baseMessage Revisa: $labels.';
      }
    }

    return baseMessage;
  }

  static String? _extractProviderName(Map<String, dynamic> appointment) {
    final provider = appointment['provider'];

    if (provider is Map<String, dynamic>) {
      final fullName = provider['fullName']?.toString();
      if (fullName != null && fullName.trim().isNotEmpty) {
        return fullName.trim();
      }

      final firstName = provider['firstName']?.toString() ?? '';
      final lastName = provider['lastName']?.toString() ?? '';
      final merged = '$firstName $lastName'.trim();

      if (merged.isNotEmpty) {
        return merged;
      }
    }

    return null;
  }

  static int? _asInt(dynamic value) {
    if (value == null) return null;
    if (value is int) return value;
    if (value is String) return int.tryParse(value);
    if (value is double) return value.toInt();
    if (value is num) return value.toInt();
    return null;
  }

  static num? _asNum(dynamic value) {
    if (value == null) return null;
    if (value is num) return value;
    if (value is String) return num.tryParse(value);
    return null;
  }

  static bool? _asBool(dynamic value) {
    if (value == null) return null;
    if (value is bool) return value;
    if (value is num) return value != 0;
    if (value is String) {
      final normalized = value.trim().toLowerCase();
      if (normalized.isEmpty) return null;
      if (['1', 'true', 'yes', 'si', 'sí'].contains(normalized)) {
        return true;
      }
      if (['0', 'false', 'no'].contains(normalized)) {
        return false;
      }
    }
    return null;
  }

  static Future<List<dynamic>> getServices({bool forceRefresh = false}) async {
    await _ensureLoaded();
    if (!forceRefresh && _cachedServices != null) {
      if (_isCacheFresh(_servicesCachedAt)) {
        return _cachedServices!;
      }
      if (_isCacheUsable(_servicesCachedAt)) {
        unawaited(_refreshServicesInBackground());
        return _cachedServices!;
      }
    }

    final uri = Uri.parse('$baseUrl/services-lite');
    final data = await _getDecodedWithRetry(
      uri,
      headers: _defaultHeaders(),
      timeout: _timeout,
      attempts: 2,
      retryDelay: _catalogRetryDelay,
      timeoutMessage:
          'No se pudieron cargar los servicios a tiempo. Intenta nuevamente.',
      connectionMessage:
          'No se pudo conectar con los servicios. Revisa tu internet e intenta nuevamente.',
    );

    if (data['success'] == true && data['data'] is List) {
      _cachedServices = List<dynamic>.from(data['data']);
      _servicesCachedAt = DateTime.now();
      await _persistCache();
      return _cachedServices!;
    }

    if (_cachedServices != null && _cachedServices!.isNotEmpty) {
      return _cachedServices!;
    }

    throw Exception('No se pudieron cargar los servicios');
  }


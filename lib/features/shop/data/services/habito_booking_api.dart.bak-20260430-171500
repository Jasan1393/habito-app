      'extras': bookingExtras,
      'extras_price': _sumExtrasPrice(bookingExtras),
      'extras_duration': _sumExtrasDuration(bookingExtras),
    };

    return normalized;
  }

  static Map<String, dynamic> _findFirstMapByKeys(
    Map<String, dynamic> source,
    List<List<String>> paths,
  ) {
    for (final path in paths) {
      dynamic current = source;
      bool valid = true;

      for (final key in path) {
        if (current is Map && current.containsKey(key)) {
          current = current[key];
        } else {
          valid = false;
          break;
        }
      }

      if (valid && current is Map<String, dynamic>) {
        return Map<String, dynamic>.from(current);
      }

      if (valid && current is Map) {
        return Map<String, dynamic>.from(current);
      }
    }

    return <String, dynamic>{};
  }

  static String? _firstNonEmpty(List<String?> values) {
    for (final value in values) {
      if (value != null && value.trim().isNotEmpty) {
        return value.trim();
      }
    }
    return null;
  }

  static List<Map<String, dynamic>> _extractBookingExtras(
    Map<String, dynamic> booking,
  ) {
    final rawExtras = booking['extras'] ??
        booking['bookingExtras'] ??
        booking['booking_extras'] ??
        booking['serviceExtras'] ??
        booking['service_extras'];
    if (rawExtras is! List) return <Map<String, dynamic>>[];

    return rawExtras
        .whereType<Map>()
        .map((item) {
          final map = Map<String, dynamic>.from(item);

          final unitPrice = _asNum(map['price']) ?? 0;
          final unitDuration = _asInt(map['duration']) ?? 0;
          final quantity = _asInt(map['quantity']) ?? 1;
          final price = _asNum(map['total_price']) ??
              _asNum(map['totalPrice']) ??
              (unitPrice * quantity);
          final duration = _asInt(map['total_duration']) ??
              _asInt(map['totalDuration']) ??
              (unitDuration * quantity);

          return {
            'id': _asInt(map['id'] ?? map['extraId'] ?? map['extra_id']),
            'extraId': _asInt(map['extraId'] ?? map['extra_id'] ?? map['id']),
            'extra_id': _asInt(map['extra_id'] ?? map['extraId'] ?? map['id']),
            'name': map['name']?.toString(),
            'description': map['description']?.toString(),
            'price': unitPrice,
            'duration': unitDuration,
            'quantity': quantity,
            'total_price': price,
            'totalPrice': price,
            'total_duration': duration,
            'totalDuration': duration,
            'raw': map,
          };
        })
        .where((item) => (_asInt(item['id']) ?? 0) > 0)
        .toList();
  }

  static num _sumExtrasPrice(List<Map<String, dynamic>> extras) {
    num total = 0;
    for (final extra in extras) {
      total += _asNum(extra['total_price']) ?? 0;
    }
    return total;
  }

  static int _sumExtrasDuration(List<Map<String, dynamic>> extras) {
    int total = 0;
    for (final extra in extras) {
      total += _asInt(extra['total_duration']) ?? 0;
    }
    return total;
  }

  static num _sumBasePlusExtras(
    Map<String, dynamic> service,
    Map<String, dynamic> booking,
    List<Map<String, dynamic>> extras,
  ) {
    final base = _asNum(booking['price']) ?? _asNum(service['price']) ?? 0;
    return base + _sumExtrasPrice(extras);
  }

  static String _normalizeView(String value) {
    final v = value.trim().toLowerCase();
    if (v == 'upcoming' || v == 'history' || v == 'all') {
      return v;
    }
    return 'all';
  }

  static String? _normalizeStatus(String? status) {
    if (status == null || status.trim().isEmpty) return null;

    final s = status.trim().toLowerCase();

    switch (s) {
      case 'approved':
      case 'confirmed':
      case 'confirmada':
      case 'confirmado':
      case 'aprobada':
      case 'aprobado':
        return 'approved';

      case 'pending':
      case 'pendiente':
      case 'waiting':
      case 'reservada':
        return 'pending';

      case 'canceled':
      case 'cancelled':
      case 'cancelada':
      case 'cancelado':
        return 'canceled';

      case 'completed':
      case 'completada':
      case 'completado':
        return 'completed';

      case 'rejected':
      case 'rechazada':
      case 'rechazado':
        return 'rejected';

      default:
        return s;
    }
  }

  static bool _isExpiredPendingStatus(
    String? normalizedStatus,
    String? bookingStart,
  ) {
    if ((normalizedStatus ?? '').trim().toLowerCase() != 'pending') {
      return false;
    }

    final parsed = _parseFlexibleDateTime(bookingStart);
    if (parsed == null) return false;

    return parsed.isBefore(DateTime.now());
  }

  static DateTime? _parseFlexibleDateTime(String? value) {
    final text = value?.trim() ?? '';
    if (text.isEmpty) return null;

    try {
      return DateTime.parse(text).toLocal();
    } catch (_) {}

    try {
      return DateTime.parse(text.replaceFirst(' ', 'T')).toLocal();
    } catch (_) {}

    return null;
  }

  static String _statusDisplayLabel(String? lifecycle, String? rawStatus) {
    switch ((lifecycle ?? '').trim().toLowerCase()) {
      case 'approved':
        return 'Confirmada';
      case 'pending':
        return 'Pendiente';
      case 'expired_pending':
        return 'Pendiente vencida';
      case 'canceled':
        return 'Cancelada';
      case 'rejected':
        return 'Rechazada';
      case 'completed':
        return 'Completada';
      default:
        final fallback = rawStatus?.trim() ?? '';
        return fallback.isEmpty ? 'Sin estado' : fallback;
    }
  }


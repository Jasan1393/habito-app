  static Future<Map<String, dynamic>> getAvailability({
    required int serviceId,
    required int employeeId,
    required int locationId,
    required String startDateTime,
    required String endDateTime,
    int persons = 1,
    List<Map<String, dynamic>> extras = const [],
  }) async {
    final queryParameters = <String, String>{
      'service_id': serviceId.toString(),
      'employee_id': employeeId.toString(),
      'location_id': locationId.toString(),
      'persons': persons.toString(),
      'start_datetime': startDateTime,
      'end_datetime': endDateTime,
    };

    if (extras.isNotEmpty) {
      queryParameters['extras'] = jsonEncode(
        extras
            .map(
              (e) => {
                'id': _asInt(e['id']) ?? _asInt(e['extraId']) ?? 0,
                'quantity': _asInt(e['quantity']) ?? 1,
                if (e['persons'] != null) 'persons': _asInt(e['persons']) ?? 1,
                if (e['duration'] != null)
                  'duration': _asInt(e['duration']) ?? 0,
                if (e['price'] != null) 'price': _asNum(e['price']) ?? 0,
                if (e['name'] != null) 'name': e['name'].toString(),
              },
            )
            .where((e) => (e['id'] as int) > 0)
            .toList(),
      );
    }

    final uri = Uri.parse('$baseUrl/availability').replace(
      queryParameters: queryParameters,
    );

    final response =
        await http.get(uri, headers: _defaultHeaders()).timeout(_timeout);

    final data = _decodeResponse(response);

    if (data['success'] == true && data['data'] is Map<String, dynamic>) {
      return Map<String, dynamic>.from(data['data']);
    }

    throw Exception(_extractErrorMessage(data));
  }

  static Future<Map<String, dynamic>> createBooking({
    String? firstName,
    String? lastName,
    String? email,
    String? phone,
    Map<String, dynamic>? customer,
    int? customerId,
    int? ameliaCustomerId,
    required int serviceId,
    required int providerId,
    required int locationId,
    required String bookingStart,
    int persons = 1,
    int duration = 0,
    String countryPhoneIso = 'ec',
    String locale = 'es_EC',
    int notifyParticipants = 1,
    String? authToken,
    List<Map<String, dynamic>> extras = const [],
    Map<String, dynamic> customFields = const {},
    ShopPaymentMethod? paymentMethod,
  }) async {
    final uri = Uri.parse('$baseUrl/bookings');

    final normalizedExtras = extras
        .map(
          (extra) => {
            'id': _asInt(extra['id']) ?? _asInt(extra['extraId']) ?? 0,
            'quantity': _asInt(extra['quantity']) ?? 1,
            if (extra['persons'] != null)
              'persons': _asInt(extra['persons']) ?? 1,
            if (extra['duration'] != null)
              'duration': _asInt(extra['duration']) ?? 0,
            if (extra['price'] != null) 'price': _asNum(extra['price']) ?? 0,
            if (extra['name'] != null) 'name': extra['name'].toString(),
          },
        )
        .where((e) => (e['id'] as int) > 0)
        .toList();

    final Map<String, dynamic> body = {
      'service_id': serviceId,
      'provider_id': providerId,
      'location_id': locationId,
      'booking_start': bookingStart,
      'persons': persons,
      'duration': duration,
      'country_phone_iso': countryPhoneIso,
      'locale': locale,
      'notify_participants': notifyParticipants,
      'extras': normalizedExtras,
      if (paymentMethod != null) ...{
        'payment_method': paymentMethod.id,
        'payment_method_title': paymentMethod.title,
        'payment_title': paymentMethod.title,
        'payment_flow': paymentMethod.flow,
        'payment_order_status': paymentMethod.orderStatus,
        'payment_requires_online': paymentMethod.requiresOnlinePayment,
      },
      if (customerId != null && customerId > 0) 'customer_id': customerId,
      if (ameliaCustomerId != null && ameliaCustomerId > 0)
        'amelia_customer_id': ameliaCustomerId,
      if (customFields.isNotEmpty) 'custom_fields': customFields,
    };

    final Map<String, dynamic> normalizedCustomer = {};

    if (customer != null && customer.isNotEmpty) {
      if (customer['first_name'] != null) {
        normalizedCustomer['first_name'] = customer['first_name'];
      } else if (customer['firstName'] != null) {
        normalizedCustomer['first_name'] = customer['firstName'];
      }

      if (customer['last_name'] != null) {
        normalizedCustomer['last_name'] = customer['last_name'];
      } else if (customer['lastName'] != null) {
        normalizedCustomer['last_name'] = customer['lastName'];
      }

      if (customer['email'] != null) {
        normalizedCustomer['email'] = customer['email'];
      }

      if (customer['phone'] != null) {
        normalizedCustomer['phone'] = customer['phone'];
      }

      if (customer['country_phone_iso'] != null) {
        normalizedCustomer['country_phone_iso'] = customer['country_phone_iso'];
      } else if (customer['countryPhoneIso'] != null) {
        normalizedCustomer['country_phone_iso'] = customer['countryPhoneIso'];
      }

      if (customer['external_id'] != null) {
        normalizedCustomer['external_id'] = customer['external_id'];
      } else if (customer['externalId'] != null) {
        normalizedCustomer['external_id'] = customer['externalId'];
      }
    }

    if ((firstName ?? '').trim().isNotEmpty) {
      body['first_name'] = firstName!.trim();
    } else if ((normalizedCustomer['first_name']?.toString() ?? '')
        .trim()
        .isNotEmpty) {
      body['first_name'] = normalizedCustomer['first_name'];
    }

    if ((lastName ?? '').trim().isNotEmpty) {
      body['last_name'] = lastName!.trim();
    } else if ((normalizedCustomer['last_name']?.toString() ?? '')
        .trim()
        .isNotEmpty) {
      body['last_name'] = normalizedCustomer['last_name'];
    }

    if ((email ?? '').trim().isNotEmpty) {
      body['email'] = email!.trim();
    } else if ((normalizedCustomer['email']?.toString() ?? '')
        .trim()
        .isNotEmpty) {
      body['email'] = normalizedCustomer['email'];
    }

    if ((phone ?? '').trim().isNotEmpty) {
      body['phone'] = phone!.trim();
    } else if ((normalizedCustomer['phone']?.toString() ?? '')
        .trim()
        .isNotEmpty) {
      body['phone'] = normalizedCustomer['phone'];
    }

    if (normalizedCustomer.isNotEmpty) {
      body['customer'] = normalizedCustomer;
    }

    body.removeWhere((key, value) {
      if (value == null) return true;
      if (value is String && value.trim().isEmpty) return true;
      return false;
    });

    final headers = authToken != null && authToken.trim().isNotEmpty
        ? _jsonAuthHeaders(authToken)
        : _jsonHeaders();

    final requestBody = jsonEncode(body);

    final response = await http
        .post(
          uri,
          headers: headers,
          body: requestBody,
        )
        .timeout(_timeout);

    final data = _decodeResponse(response);

    if (data['success'] != true) {
      throw Exception(_extractErrorMessage(data));
    }

    final payload = _extractBookingPayload(data);
    final normalized = _normalizeCreatedBookingResponse(payload, data);

    return {
      'success': true,
      ...normalized,
      'raw': payload,
      'response': data,
    };
  }


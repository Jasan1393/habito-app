  static Future<Map<String, dynamic>> getMyBookings({
    required String token,
    String? status,
    int limit = 20,
    int page = 1,
    bool includeRaw = false,
    String view = 'all',
  }) async {
    final normalizedView = _normalizeView(view);

    final queryParameters = <String, String>{
      'limit': limit.toString(),
      'page': page.toString(),
      'include_raw': includeRaw ? '1' : '0',
      'view': normalizedView,
    };

    if (status != null && status.trim().isNotEmpty) {
      queryParameters['status'] = status.trim();
    }

    final uri = Uri.parse('$baseUrl/my-bookings').replace(
      queryParameters: queryParameters,
    );

    final data = await _getDecodedWithRetry(
      uri,
      headers: _authHeaders(token),
      timeout: _myBookingsTimeout,
    );

    if (data['success'] != true) {
      throw Exception(_extractErrorMessage(data));
    }

    final payload = data['data'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(data['data'])
        : <String, dynamic>{};

    final rawItems = payload['items'] is List
        ? List<dynamic>.from(payload['items'])
        : <dynamic>[];

    final items = rawItems
        .whereType<Map>()
        .map((item) => _normalizeMyBookingItem(Map<String, dynamic>.from(item)))
        .toList();

    return {
      'success': true,
      'customer_id': _asInt(payload['customerId']),
      'total': _asInt(payload['total']) ?? items.length,
      'page': _asInt(payload['page']) ?? page,
      'limit': _asInt(payload['limit']) ?? limit,
      'has_more': payload['hasMore'] == true,
      'status_filter': payload['statusFilter']?.toString(),
      'view': payload['view']?.toString() ?? normalizedView,
      'include_raw': payload['includeRaw'] == true || includeRaw,
      'items': items,
      'raw': payload,
    };
  }

  static Future<Map<String, dynamic>> _getDecodedWithRetry(
    Uri uri, {
    required Map<String, String> headers,
    required Duration timeout,
    int attempts = 2,
    Duration retryDelay = _retryDelay,
    String timeoutMessage =
        'No pudimos cargar tus citas a tiempo. Revisa tu conexión e intenta nuevamente.',
    String connectionMessage =
        'No pudimos conectar con tus citas. Revisa tu internet e intenta nuevamente.',
  }) async {
    Object? lastError;

    for (var attempt = 0; attempt < attempts; attempt++) {
      try {
        final response = await http.get(uri, headers: headers).timeout(timeout);
        return _decodeResponse(response);
      } on TimeoutException catch (e) {
        lastError = e;
      } on http.ClientException catch (e) {
        lastError = e;
      }

      if (attempt < attempts - 1) {
        await Future<void>.delayed(retryDelay);
      }
    }

    if (lastError is TimeoutException) {
      throw Exception(timeoutMessage);
    }

    throw Exception(connectionMessage);
  }

  static Future<Map<String, dynamic>> getMyBooking({
    required String token,
    int? appointmentId,
    int? bookingId,
  }) async {
    if ((appointmentId ?? 0) <= 0 && (bookingId ?? 0) <= 0) {
      throw Exception('No encontramos la cita solicitada.');
    }

    final queryParameters = <String, String>{
      if ((appointmentId ?? 0) > 0) 'appointment_id': appointmentId.toString(),
      if ((bookingId ?? 0) > 0) 'booking_id': bookingId.toString(),
    };

    final uri = Uri.parse('$baseUrl/my-booking').replace(
      queryParameters: queryParameters,
    );

    final data = await _getDecodedWithRetry(
      uri,
      headers: _authHeaders(token),
      timeout: _myBookingsTimeout,
    );

    if (data['success'] != true) {
      throw Exception(_extractErrorMessage(data));
    }

    final payload = data['data'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(data['data'])
        : <String, dynamic>{};
    final item = payload['item'];

    if (item is! Map) {
      throw Exception('No encontramos la cita solicitada.');
    }

    return {
      'success': true,
      'item': _normalizeMyBookingItem(Map<String, dynamic>.from(item)),
      'raw': payload,
    };
  }

  static Map<String, dynamic> _normalizeMyBookingItem(
    Map<String, dynamic> item,
  ) {
    final service = item['service'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(item['service'])
        : <String, dynamic>{};

    final provider = item['provider'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(item['provider'])
        : <String, dynamic>{};

    final location = item['location'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(item['location'])
        : <String, dynamic>{};

    final booking = item['booking'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(item['booking'])
        : <String, dynamic>{};

    final customer = booking['customer'] is Map<String, dynamic>
        ? Map<String, dynamic>.from(booking['customer'])
        : item['customer'] is Map<String, dynamic>
            ? Map<String, dynamic>.from(item['customer'])
            : <String, dynamic>{};

    final bookingStart = item['bookingStart']?.toString();
    final bookingEnd = item['bookingEnd']?.toString();

    final rawStatus = item['status']?.toString() ??
        booking['status']?.toString() ??
        item['appointmentStatus']?.toString();

    final normalizedStatus =
        item['statusNormalized']?.toString() ?? _normalizeStatus(rawStatus);
    final derivedExpiredPending =
        _asBool(item['isExpiredPending'] ?? item['is_expired_pending']) ??
            _isExpiredPendingStatus(normalizedStatus, bookingStart);
    final statusLifecycle = _firstNonEmpty([
          item['statusLifecycle']?.toString(),
          item['status_lifecycle']?.toString(),
          derivedExpiredPending ? 'expired_pending' : normalizedStatus,
        ]) ??
        '';
    final statusDisplay = _firstNonEmpty([
          item['statusDisplay']?.toString(),
          item['status_display']?.toString(),
        ]) ??
        _statusDisplayLabel(statusLifecycle, rawStatus);

    final providerName = provider['fullName']?.toString().trim().isNotEmpty ==
            true
        ? provider['fullName']?.toString()
        : '${provider['firstName'] ?? ''} ${provider['lastName'] ?? ''}'.trim();

    final extras = _extractBookingExtras(booking);
    final customerName = _firstNonEmpty([
      customer['fullName']?.toString(),
      customer['name']?.toString(),
      [
        customer['firstName']?.toString(),
        customer['lastName']?.toString(),
      ].where((part) => part != null && part.trim().isNotEmpty).join(' '),
      item['customerName']?.toString(),
      item['customer_name']?.toString(),
    ]);

    return {
      'id': _asInt(item['id']),
      'appointment_id': _asInt(item['appointmentId'] ?? item['id']),
      'status': rawStatus,
      'status_normalized': normalizedStatus,
      'status_lifecycle': statusLifecycle,
      'status_display': statusDisplay,
      'is_expired_pending': derivedExpiredPending,
      'appointment_status': item['appointmentStatus']?.toString(),
      'booking_start': bookingStart,
      'booking_end': bookingEnd,
      'booking_start_timestamp': _asInt(item['bookingStartTimestamp']),
      'booking_end_timestamp': _asInt(item['bookingEndTimestamp']),
      'service_id': _asInt(service['id']),
      'service_name': service['name']?.toString(),
      'service_price': _asNum(service['price']),
      'service_duration': _asInt(service['duration']),
      'service_category_id': _asInt(service['categoryId']),
      'service_extras': service['extras'] is List
          ? List<dynamic>.from(service['extras'])
          : <dynamic>[],
      'provider_id': _asInt(provider['id']),
      'provider_first_name': provider['firstName']?.toString(),
      'provider_last_name': provider['lastName']?.toString(),
      'provider_name': providerName,
      'provider_email': provider['email']?.toString(),
      'provider_phone': provider['phone']?.toString(),
      'provider_description': provider['description']?.toString(),
      'provider_picture': provider['pictureFullPath']?.toString(),
      'provider_thumb': provider['pictureThumbPath']?.toString(),
      'location_id': _asInt(location['id']),
      'location_name': location['name']?.toString(),
      'location_address': location['address']?.toString(),
      'location_description': location['description']?.toString(),
      'location_phone': location['phone']?.toString(),
      'location_latitude': _asNum(location['latitude']),
      'location_longitude': _asNum(location['longitude']),
      'booking_id': _asInt(booking['id']),
      'customer_id': _asInt(
        booking['customerId'] ?? customer['id'] ?? item['customerId'],
      ),
      'customer_name': customerName,
      'customer_first_name': customer['firstName']?.toString(),
      'customer_last_name': customer['lastName']?.toString(),
      'customer_email': _firstNonEmpty([
        customer['email']?.toString(),
        item['customerEmail']?.toString(),
        item['customer_email']?.toString(),
      ]),
      'customer_phone': _firstNonEmpty([
        customer['phone']?.toString(),
        item['customerPhone']?.toString(),
        item['customer_phone']?.toString(),
      ]),
      'persons': _asInt(booking['persons']),
      'price': _asNum(booking['price']),
      'booking_status': booking['status']?.toString(),
      'extras': extras,
      'extras_price': _sumExtrasPrice(extras),
      'extras_duration': _sumExtrasDuration(extras),
      'total_price': _asNum(booking['totalPrice']) ??
          _asNum(booking['price']) ??
          _sumBasePlusExtras(service, booking, extras),
      'total_duration': _asInt(booking['totalDuration']) ??
          (_asInt(service['duration']) ?? 0) + _sumExtrasDuration(extras),
      if (item.containsKey('raw')) 'raw': item['raw'],
    };
  }

  static Map<String, dynamic> _normalizeCreatedBookingResponse(
    Map<String, dynamic> payload,
    Map<String, dynamic> responseData,
  ) {
    final appointment = _findFirstMapByKeys(
      payload,
      const [
        ['appointment'],
        ['data', 'appointment'],
        ['booking', 'appointment'],
      ],
    );

    final booking = _findFirstMapByKeys(
      payload,
      const [
        ['booking'],
        ['data', 'booking'],
      ],
    );

    final customer = _findFirstMapByKeys(
      payload,
      const [
        ['customer'],
        ['booking', 'customer'],
        ['data', 'customer'],
      ],
    );

    final service = _findFirstMapByKeys(
      payload,
      const [
        ['bookable'],
        ['service'],
        ['data', 'service'],
      ],
    );

    final location = _findFirstMapByKeys(
      payload,
      const [
        ['location'],
        ['appointment', 'location'],
      ],
    );

    final payment = _findFirstMapByKeys(
      payload,
      const [
        ['payment'],
        ['data', 'payment'],
      ],
    );

    final habitoPayment = _findFirstMapByKeys(
      payload,
      const [
        ['habito_payment'],
        ['data', 'habito_payment'],
      ],
    );

    final appointmentId = _asInt(
      appointment['id'] ??
          payload['appointment_id'] ??
          payload['appointmentId'] ??
          responseData['appointment_id'] ??
          responseData['appointmentId'],
    );

    final bookingId = _asInt(
      booking['id'] ??
          payload['booking_id'] ??
          payload['bookingId'] ??
          responseData['booking_id'] ??
          responseData['bookingId'],
    );

    final bookingExtras = _extractBookingExtras(booking);

    final normalized = <String, dynamic>{
      'message': payload['message']?.toString() ??
          responseData['message']?.toString() ??
          'Reserva creada correctamente',
      'appointment_id': appointmentId,
      'booking_id': bookingId,
      'customer_id': _asInt(
        customer['id'] ??
            booking['customerId'] ??
            payload['customer_id'] ??
            payload['customerId'],
      ),
      'payment_id': _asInt(payment['id'] ?? payload['paymentId']),
      'status': booking['status']?.toString() ??
          appointment['status']?.toString() ??
          payload['status']?.toString() ??
          'pending',
      'status_normalized': _normalizeStatus(
        booking['status']?.toString() ??
            appointment['status']?.toString() ??
            payload['status']?.toString(),
      ),
      'booking_start': appointment['bookingStart']?.toString() ??
          payload['booking_start']?.toString() ??
          payload['bookingStart']?.toString(),
      'booking_end': appointment['bookingEnd']?.toString() ??
          payload['booking_end']?.toString() ??
          payload['bookingEnd']?.toString(),
      'service_id': _asInt(
        service['id'] ??
            appointment['serviceId'] ??
            payload['service_id'] ??
            payload['serviceId'],
      ),
      'service_name':
          service['name']?.toString() ?? payload['service_name']?.toString(),
      'service_price': _asNum(service['price'] ?? booking['price']),
      'provider_id': _asInt(
        appointment['providerId'] ??
            (appointment['provider'] is Map
                ? appointment['provider']['id']
                : null) ??
            payload['provider_id'] ??
            payload['providerId'],
      ),
      'provider_name': _extractProviderName(appointment) ??
          payload['provider_name']?.toString(),
      'location_id': _asInt(
        location['id'] ??
            appointment['locationId'] ??
            payload['location_id'] ??
            payload['locationId'],
      ),
      'location_name':
          location['name']?.toString() ?? payload['location_name']?.toString(),
      'location_address': location['address']?.toString(),
      'location_description': location['description']?.toString(),
      'location_phone': location['phone']?.toString(),
      'location_latitude': _asNum(location['latitude']),
      'location_longitude': _asNum(location['longitude']),
      'location_image': location['pictureFullPath']?.toString(),
      'location_thumb': location['pictureThumbPath']?.toString(),
      'customer_name':
          '${customer['firstName'] ?? ''} ${customer['lastName'] ?? ''}'.trim(),
      'customer_first_name': customer['firstName']?.toString(),
      'customer_last_name': customer['lastName']?.toString(),
      'customer_email': customer['email']?.toString(),
      'customer_phone': customer['phone']?.toString(),
      'persons': _asInt(booking['persons'] ?? payload['persons']),
      'duration': _asInt(
        booking['duration'] ?? service['duration'] ?? payload['duration'],
      ),
      'price': _asNum(booking['price'] ?? payload['price']),
      'booking_token': booking['token']?.toString(),
      'payment_status': payment['status']?.toString(),
      'payment_gateway': payment['gateway']?.toString(),
      'payment_method': habitoPayment['method']?.toString() ??

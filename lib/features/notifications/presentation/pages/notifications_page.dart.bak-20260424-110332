import 'package:flutter/material.dart';

import '../../../../core/routes/app_routes.dart';
import '../../../../core/services/notification_inbox_service.dart';
import '../../../../core/theme/app_colors.dart';

class NotificationsPage extends StatefulWidget {
  const NotificationsPage({super.key});

  @override
  State<NotificationsPage> createState() => _NotificationsPageState();
}

class _NotificationsPageState extends State<NotificationsPage> {
  List<Map<String, dynamic>> _items = [];
  bool _isLoading = true;

  @override
  void initState() {
    super.initState();
    Future.microtask(_load);
  }

  Future<void> _load() async {
    final items = await NotificationInboxService.load();
    if (!mounted) return;
    setState(() {
      _items = items;
      _isLoading = false;
    });
  }

  Future<void> _markAllRead() async {
    await NotificationInboxService.markAllRead();
    await _load();
  }

  Future<void> _openNotification(Map<String, dynamic> item) async {
    final id = (item['id'] ?? '').toString();
    if (id.isNotEmpty) {
      await NotificationInboxService.markRead(id);
    }

    if (!mounted) return;

    final data = _asMap(item['data']);
    final appointmentId = _parseInt(
      data['appointmentId'] ?? data['appointment_id'] ?? data['appointment'],
    );
    final bookingId = _parseInt(
      data['bookingId'] ?? data['booking_id'] ?? data['booking'],
    );

    await _load();

    if (!mounted) return;

    if (appointmentId != null || bookingId != null) {
      Navigator.pushNamed(
        context,
        AppRoutes.pushAppointment,
        arguments: {
          'appointmentId': appointmentId,
          'bookingId': bookingId,
        },
      );
    }
  }

  String _formatDate(String value) {
    final parsed = DateTime.tryParse(value);
    if (parsed == null) return '';

    final now = DateTime.now();
    final local = parsed.toLocal();

    if (now.year == local.year &&
        now.month == local.month &&
        now.day == local.day) {
      return 'Hoy, ${local.hour.toString().padLeft(2, '0')}:${local.minute.toString().padLeft(2, '0')}';
    }

    return '${local.day.toString().padLeft(2, '0')}/${local.month.toString().padLeft(2, '0')}/${local.year}';
  }

  @override
  Widget build(BuildContext context) {
    final unreadCount = _items.where((item) => item['read'] != true).length;

    return Scaffold(
      backgroundColor: AppColors.background,
      appBar: AppBar(
        backgroundColor: AppColors.background,
        foregroundColor: AppColors.textPrimary,
        elevation: 0,
        title: const Text('Notificaciones'),
        actions: [
          if (_items.isNotEmpty)
            TextButton(
              onPressed: unreadCount == 0 ? null : _markAllRead,
              child: const Text(
                'Leer todo',
                style: TextStyle(fontWeight: FontWeight.w800),
              ),
            ),
        ],
      ),
      body: RefreshIndicator(
        color: const Color(0xFFD4AF37),
        onRefresh: _load,
        child: _isLoading
            ? const Center(
                child: CircularProgressIndicator(color: Color(0xFFD4AF37)),
              )
            : _items.isEmpty
                ? const _EmptyNotificationsView()
                : ListView(
                    padding: const EdgeInsets.fromLTRB(16, 8, 16, 24),
                    children: [
                      _NotificationsHero(unreadCount: unreadCount),
                      const SizedBox(height: 20),
                      ..._items.map(
                        (item) => Padding(
                          padding: const EdgeInsets.only(bottom: 12),
                          child: _NotificationCard(
                            item: item,
                            dateLabel: _formatDate(
                                (item['received_at'] ?? '').toString()),
                            onTap: () => _openNotification(item),
                          ),
                        ),
                      ),
                    ],
                  ),
      ),
    );
  }

  static Map<String, dynamic> _asMap(dynamic value) {
    if (value is Map<String, dynamic>) return value;
    if (value is Map) {
      return value.map((key, val) => MapEntry(key.toString(), val));
    }
    return <String, dynamic>{};
  }

  static int? _parseInt(dynamic value) {
    if (value == null) return null;
    if (value is int) return value;
    return int.tryParse(value.toString());
  }
}

class _NotificationsHero extends StatelessWidget {
